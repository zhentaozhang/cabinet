DATABASE_URL=postgres://user@localhost:5432/cabinet_dev
DEMO_USER_ID=usr_zhen
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_REQUIRED=false
# Only explicit demo environments may replace a failed/missing model call with a deterministic draft.
DEMO_MODE=false
DEMO_LOGIN_ENABLED=true
DEMO_RESET_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# --- Search connectors (M1: real retrieval) ---
# Both optional. Without either key a research run records `not_connected`
# and produces no evidence, instead of inventing citations.
BRAVE_API_KEY=
# Fallback provider, used only when Brave fails in a retryable way.
TAVILY_API_KEY=
# What one external retrieval costs, in cents. Leave empty (or 0) when your plan
# is not metered per request: the UI then says 未计价 instead of guessing.
# Retrieval spend is reported separately and never folded into the model budget.
SEARCH_COST_CENTS_PER_REQUEST=

# --- Email delivery (M3: proactive notifications) ---
# All optional. With no SMTP_HOST every queued notice is recorded as `skipped`
# (never as sent), so the outbox log stays truthful.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when omitted.
SMTP_FROM=
# How often the delivery runner may run; it is a cron job, not an in-process timer.
NOTIFY_BATCH_SIZE=20

# --- Durable run execution ---
# inline (default): POST /api/tasks/:id/run executes in the request, so a single
# `next start` is a complete product. worker: the request only queues a job and
# returns 202, and `pnpm run:worker` executes it — a restart can no longer lose
# a run or strand its budget hold.
RUN_EXECUTION=inline
# How long a claimed job may run before another worker may take it over.
RUN_LEASE_MINUTES=10
# A run still `running` after this long is settled by the recovery pass:
# unknown usage if it may have reached a provider, released if it never left.
RUN_STALE_MINUTES=15
RUN_WORKER_INTERVAL_MS=3000

# Operator token for GET /api/metrics (queue depth, stale leases, mail backlog).
# Unset means the endpoint does not exist; it is never public.
OPS_TOKEN=
