DATABASE_URL=postgres://user@localhost:5432/cabinet_dev
DEMO_USER_ID=usr_zhen
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_REQUIRED=false
# Only explicit demo environments may replace a failed/missing model call with a deterministic draft.
DEMO_MODE=false
DEMO_LOGIN_ENABLED=true
DEMO_RESET_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# --- Search connectors (M1: real retrieval) ---
# Both optional. Without either key a research run records `not_connected`
# and produces no evidence, instead of inventing citations.
BRAVE_API_KEY=
# Fallback provider, used only when Brave fails in a retryable way.
TAVILY_API_KEY=

# --- Email delivery (M3: proactive notifications) ---
# All optional. With no SMTP_HOST every queued notice is recorded as `skipped`
# (never as sent), so the outbox log stays truthful.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER when omitted.
SMTP_FROM=
# How often the delivery runner may run; it is a cron job, not an in-process timer.
NOTIFY_BATCH_SIZE=20
