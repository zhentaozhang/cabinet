DATABASE_URL=postgres://user@localhost:5432/cabinet_dev
DEMO_USER_ID=usr_zhen
OPENAI_API_KEY=
# OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
AUTH_REQUIRED=false
DEMO_LOGIN_ENABLED=true
DEMO_RESET_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# Observability -----------------------------------------------------------------
# debug | info | warn | error. Every line is one JSON object on stdout.
OBS_LOG_LEVEL=info
# Salt for the pseudonymous user handle written to logs (`u_xxxxxxxx`). Rotating
# it breaks correlation with older lines, so treat it like a long-lived secret.
OBS_USER_SALT=replace-with-openssl-rand-hex-16
# Overrides the version reported by GET /api/health when the host does not
# provide one (Vercel sets VERCEL_GIT_COMMIT_SHA automatically).
# CABINET_VERSION=
