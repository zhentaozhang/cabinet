{
  "name": "cabinet",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:sync-policy": "tsx scripts/sync-policy.ts",
    "db:setup": "pnpm db:push && pnpm db:seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:watch": "vitest --maxWorkers=1 --no-file-parallelism",
    "test:db:setup": "DATABASE_URL=${DATABASE_URL_TEST:-postgres://zhentao@localhost:5432/cabinet_test} drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "notify:deliver": "tsx scripts/deliver-outbox.ts",
    "run:worker": "tsx scripts/run-worker.ts",
    "run:worker:once": "tsx scripts/run-worker.ts --once",
    "preflight": "tsx scripts/preflight.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.99",
    "ai": "^7.0.148",
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.15.1"
